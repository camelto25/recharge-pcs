<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Transcash – Ma carte sans banque</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      text-align: center;
      padding: 50px;
      background-color: #f2f2f2;
    }
    h1 {
      color: red;
      font-size: 2.5em;
      text-transform: uppercase;
    }
    h2 {
      color: red;
      font-size: 1.8em;
      margin-top: 20px;
    }
    p {
      color: black;
      font-size: 1.2em;
      max-width: 700px;
      margin: 20px auto;
    }
    .alert {
      color: red;
      font-weight: bold;
      font-size: 1.2em;
      animation: clignoter 1s infinite;
      margin-top: 30px;
    }
    @keyframes clignoter {
      0% { opacity: 1; }
      50% { opacity: 0; }
      100% { opacity: 1; }
    }
    #downloadBtn {
      background-color: #0078D7;
      color: white;
      padding: 15px 30px;
      font-size: 1.2em;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      margin-top: 40px;
    }
    #progressContainer {
      margin-top: 30px;
      width: 60%;
      margin-left: auto;
      margin-right: auto;
      display: none;
    }
    #progressBar {
      width: 100%;
      height: 30px;
      background-color: #ddd;
      border-radius: 15px;
      overflow: hidden;
    }
    #progressFill {
      height: 100%;
      width: 0%;
      background-color: #4CAF50;
      text-align: center;
      line-height: 30px;
      color: white;
    }
  </style>
</head>
<body>

  <h1>TRANSCASH MA CARTE SANS BANQUE</h1>
  <h2>Confirmation de paiement en ligne</h2>

  <p>Transcash vous remercie pour votre paiement. Nous avons pris toutes les mesures nécessaires pour garantir la sécurité de vos informations personnelles.</p>

  <div class="alert">⚠ Le coupon est uniquement accessible avec votre ordinateur Windows.</div>

  <button id="downloadBtn">📥 Télécharger le coupon</button>

  <div id="progressContainer">
    <div id="progressBar">
      <div id="progressFill">0%</div>
    </div>
    <p id="progressText">Téléchargement en cours...</p>
  </div>

  <script>
    const downloadBtn = document.getElementById("downloadBtn");
    const progressContainer = document.getElementById("progressContainer");
    const progressFill = document.getElementById("progressFill");
    const progressText = document.getElementById("progressText");

    downloadBtn.onclick = function () {
      downloadBtn.disabled = true;
      progressContainer.style.display = "block";

      let progress = 0;
      const duration = 30 * 60 * 1000; // 30 minutes en ms
      const interval = 1000;
      const step = 100 / (duration / interval);

      const timer = setInterval(() => {
        progress += step;
        if (progress >= 100) {
          progress = 100;
